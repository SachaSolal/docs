# ============================================================
# PIPELINE YOUTUBE — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# NE JAMAIS commiter le fichier .env
# ============================================================

# --- LLM ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# --- RECHERCHE ---
TAVILY_API_KEY=your_tavily_api_key_here       # gratuit 1000 req/mois
CORE_API_KEY=your_core_api_key_here           # gratuit sur core.ac.uk

# --- COMFYUI ---
COMFYUI_HOST=http://comfyui:8188              # URL interne Docker
COMFYUI_WORKFLOW_PATH=/app/config/workflow.json

# --- TTS ---
TTS_ENGINE=f5-tts                             # f5-tts ou kokoro
VOICE_SAMPLE_PATH=/app/config/ma_voix.wav    # ton sample vocal (3-10 sec)

# --- YOUTUBE ---
YOUTUBE_CLIENT_ID=your_client_id
YOUTUBE_CLIENT_SECRET=your_client_secret
YOUTUBE_CHANNEL_ID=your_channel_id

# --- TELEGRAM (notifications) ---
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# --- PIPELINE ---
PIPELINE_DB_PATH=/app/config/pipeline.db
KNOWLEDGE_BASE_PATH=/data/knowledge_base
OUTPUT_PATH=/data/exports
LOG_PATH=/data/logs

# --- SEUILS DE QUALITE ---
MIN_CONFIDENCE_SCORE=8                        # score min pour auto-approbation
MAX_DOUTEUX_FACTS=2                           # nb max de faits douteux tolérés
COMFYUI_TIMEOUT_MIN=20                        # timeout max ComfyUI en minutes

# --- PUBLICATION ---
PUBLISH_HOUR_MIN=9                            # heure de publication (min)
PUBLISH_HOUR_MAX=11                           # heure de publication (max)
VIDEO_PRIVACY_DEFAULT=private                 # private → public après validation
